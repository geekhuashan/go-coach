{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "go-coach",
  "main": "cloud/family-entry.mjs",
  "compatibility_date": "2026-09-01",
  "account_id": "ed5f390cdcb11823287d7e4cc55c85b0",
  "workers_dev": false,
  "routes": [],
  "assets": {
    "directory": "./static",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "go-coach-wnam",
      "database_id": "491a5e4a-6833-47c3-be5d-975a13d7ea83",
      "migrations_dir": "cloud/migrations"
    }
  ],
  "vars": {
    "HOUSEHOLD_ID": "home"
  },
  "containers": [
    {
      "class_name": "KataGoContainer",
      "image": "./deploy/cloudflare/Dockerfile",
      "image_build_context": ".",
      "instance_type": { "vcpu": 2, "memory_mib": 6144, "disk_mb": 4000 },
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "ENGINE", "class_name": "KataGoContainer" }]
  },
  "migrations": [{ "tag": "v1-katago-container", "new_sqlite_classes": ["KataGoContainer"] }],
  "r2_buckets": [
    {
      "binding": "VIDEOS",
      "bucket_name": "go-coach-videos"
    }
  ]
}

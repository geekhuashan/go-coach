{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "go-coach",
  "main": "cloud/worker.mjs",
  "compatibility_date": "2026-09-01",
  "account_id": "00000000000000000000000000000000",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "go.example.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./static",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "go-coach",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "cloud/migrations"
    }
  ],
  "vars": {
    "HOUSEHOLD_ID": "home"
  },
  "r2_buckets": [
    {
      "binding": "VIDEOS",
      "bucket_name": "go-coach-videos"
    }
  ]
}

{
  "name": "go-coach",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:cloud": "wrangler dev --port 8787",
    "deploy": "npm run build:patterns && wrangler deploy",
    "test:cloud": "node --test cloud/tests/*.test.mjs",
    "db:local": "wrangler d1 migrations apply go-coach --local",
    "db:remote": "wrangler d1 migrations apply go-coach --remote",
    "build:patterns": "esbuild cloud/match-patterns-worker.mjs --bundle --platform=browser --format=iife --target=safari15 --outfile=static/pattern-worker.js"
  },
  "devDependencies": {
    "wrangler": "4.129.0"
  }
}

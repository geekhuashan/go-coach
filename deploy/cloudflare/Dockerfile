# KataGo for Cloudflare Containers. Build context is the repository root;
# binaries and the model are staged in .local/cloudflare-engine (see docs/CLOUD.md).
FROM python:3.12-slim-bookworm@sha256:2ed6491b93cd49272ee6de2b5a38440c3448360322c089fc23e370722d74179d
RUN useradd --uid 1000 --no-create-home --shell /usr/sbin/nologin engine
WORKDIR /app
COPY .local/cloudflare-engine/squashfs-root /app/squashfs-root
COPY .local/cloudflare-engine/model-b18.bin.gz /app/model-b18.bin.gz
COPY engine.py engine_bridge.py /app/
COPY deploy/cloudflare/analysis.cfg /app/analysis.cfg
RUN mkdir /app/.local && chown engine /app/.local
ENV GO_COACH_KATAGO=/app/squashfs-root/AppRun \
    GO_COACH_MODEL=/app/model-b18.bin.gz \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
USER engine
EXPOSE 8080
# The port is reachable only through the Worker's Durable Object; the token is
# generated by that Durable Object and passed in at start.
CMD ["python3", "engine_bridge.py", "--host", "0.0.0.0", "--port", "8080", "--token-env", "GO_COACH_ENGINE_TOKEN"]
